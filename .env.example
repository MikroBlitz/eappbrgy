APP_NAME=Govana
APP_TIMEZONE=Asia/Manila
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost

# For testing local network
#API_URL=http://192.168.1.30:8000
#FRONTEND_URL=http://192.168.1.30:3000
#SANCTUM_STATEFUL_DOMAINS=192.168.1.30

PHP_CLI_SERVER_WORKERS=4
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
#DB_HOST=127.0.0.1 # Uncomment this line on manual setup
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=govana
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SESSION_PATH=/
CACHE_DRIVER=redis
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
#REDIS_HOST=127.0.0.1 # Uncomment this line on manual setup
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=govana@mail.com
MAIL_FROM_NAME="${APP_NAME}"

OTP_SECRET_KEY=

GRAPHIQL_ENABLED=true

VITE_APP_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OCTANE_SERVER=swoole

BROADCAST_DRIVER=reverb

REVERB_APP_ID=6feC1iT7Ucsl25lwAEOXMfg1IwzC6twg
REVERB_APP_KEY=Hbc6j0XQ5b9FY3NTl3sSBAhR5uWcxSSC

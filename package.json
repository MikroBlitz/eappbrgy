{
    "name": "nuxt-app",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "start": "concurrently \"nuxt dev\" \"php artisan serve\" \"php artisan reverb:start --port=6001\"",
        "octane": "concurrently \"php artisan octane:start --workers=8 --task-workers=8 --max-requests=300\" \"php artisan reverb:start --port=6002 --debug\"",
        "octane-host": "php artisan octane:start --workers=8 --task-workers=8 --max-requests=300 --host=192.168.254.112 --port=8000",
        "api:test": "wrk -c 100 -t 4 -d 5 http://127.0.0.1:8000/graphql",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "codegen": "graphql-codegen --config codegen.ts",
        "dir-tree": "tree -I \"node_modules|vendor|.nuxt|.output|storage\" --charset=ascii --noreport > DIRECTORY.md",
        "migrate-fresh": "php artisan migrate:fresh --seed"
    },
    "dependencies": {
        "@graphql-typed-document-node/core": "3.1.1",
        "@nuxt/eslint": "1.1.0",
        "@nuxt/ui": "2.22.1",
        "@nuxtjs/color-mode": "3.5.2",
        "@nuxtjs/tailwindcss": "6.13.2",
        "@pinia-plugin-persistedstate/nuxt": "^1.2.1",
        "@pinia/nuxt": "^0.11.2",
        "@popperjs/core": "^2.11.8",
        "apollo-upload-client": "^18.0.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "eslint": "^9.34.0",
        "face-api.js": "^0.22.2",
        "jspdf": "^3.0.2",
        "jspdf-autotable": "^5.0.2",
        "lucide-vue-next": "^0.487.0",
        "nuxt": "^4.2.1",
        "pinia": "^3.0.3",
        "pinia-plugin-persistedstate": "^4.5.0",
        "tailwind-merge": "^3.3.1",
        "v-calendar": "^3.1.2",
        "vue": "latest",
        "vue-draggable-plus": "^0.6.0",
        "vue-router": "latest",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^5.0.7",
        "@graphql-codegen/client-preset": "4.5.1",
        "@graphql-codegen/introspection": "4.0.3",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify-json/solar": "^1.2.4",
        "@laravel/echo-vue": "^2.2.0",
        "@nuxtjs/apollo": "^5.0.0-alpha.15",
        "@parcel/watcher": "^2.5.1",
        "@vueuse/core": "^12.8.2",
        "autoprefixer": "^10.4.21",
        "axios": "^1.11.0",
        "concurrently": "^9.2.1",
        "eslint-plugin-perfectionist": "^4.15.0",
        "laravel-echo": "^2.2.0",
        "postcss": "^8.5.6",
        "prettier": "3.5.2",
        "pusher-js": "^8.4.0",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.9.2",
        "vite": "^6.3.5",
        "vue-tsc": "^2.2.12"
    }
}
